{{ `<?xml version="1.0" encoding="utf-8" standalone="yes"?>` | safeHTML }}
<rss version="2.0"><channel><title>{{ partial "title.html" . }}</title><link>{{ .Permalink }}</link><description>{{ .Description | default (index hugo.Data.focus .Site.Language.Lang).introduction }}</description><language>{{ .Site.Language.Locale }}</language>
{{ range .Site.RegularPages }}{{ $record := partial "record.html" . }}{{ if and $record $record.display.visible }}{{ if or $.IsHome (eq .Section $.Section) }}
<item><title>{{ partial "title.html" . }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid>{{ if eq $record.date_precision "day" }}<pubDate>{{ (time.AsTime $record.date).Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>{{ end }}<description>{{ .Params.summary | default (.Plain | truncate 250) }}</description></item>
{{ end }}{{ end }}{{ end }}</channel></rss>
